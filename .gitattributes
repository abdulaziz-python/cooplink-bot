# Auto detect text files and perform LF normalization
* text=auto

# Force the following filetypes to have unix eols, so Windows does not break them
*.* text eol=lf

# Python files
*.py text diff=python eol=lf

# Windows specific files
*.bat text eol=crlf

# Binary files
*.db binary
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.pdf binary

